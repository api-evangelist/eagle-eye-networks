    "MicrosoftActiveDirectoryOidcSsoSettings": {
      "type": "object",
      "required": [
        "config"
      ],
      "description": "With the \"Microsoft Active Directory\" OIDC SSO type, a specific active directory is configured as identity provider for the account.  The specific directory is identified by the required tenantId. Any user and guest under this specific active directory can use this configuration to login.  \"Microsoft Accounts\", also known as \"Personal accounts\" can only be used to identify as a user if that account has been invited as a guest account in the Active Directory.  Auto User Provisioning can be enabled for this configuration.\n",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "microsoftActiveDirectory"
          ]
        },
        "config": {
          "type": "object",
          "properties": {
